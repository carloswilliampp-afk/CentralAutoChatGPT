<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Interactive Native MapView (OSMDroid) -->
    <org.osmdroid.views.MapView
        android:id="@+id/osm_map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Destination Search Bar (Coolwalk Style) -->
    <LinearLayout
        android:id="@+id/bar_search_destination"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_pill_button"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_search"
            app:tint="@color/car_text_secondary" />

        <TextView
            android:id="@+id/tv_search_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/search_destination_hint"
            android:textColor="@color/car_text_secondary"
            android:textSize="16sp" />

        <!-- Voice Search Button -->
        <FrameLayout
            android:id="@+id/btn_map_voice"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_round"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                app:tint="@color/car_accent_blue" />
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom Left Floating HUD: Speedometer & GPS -->
    <LinearLayout
        android:id="@+id/hud_speedometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill_button"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_speedometer"
            app:tint="@color/car_speed_accent" />

        <TextView
            android:id="@+id/tv_car_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/speed_zero"
            android:textColor="@color/car_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/km_h"
            android:textColor="@color/car_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom Right Floating Controls: Recenter, Google Maps, Waze -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Google Maps Direct Launch -->
        <LinearLayout
            android:id="@+id/btn_launch_google_maps"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_pill_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_google_maps" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Maps"
                android:textColor="@color/car_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <!-- Waze Direct Launch -->
        <LinearLayout
            android:id="@+id/btn_launch_waze"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_pill_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_waze" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Waze"
                android:textColor="@color/car_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <!-- GPS Recenter Button -->
        <FrameLayout
            android:id="@+id/btn_map_recenter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_round"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_gps_fixed"
                app:tint="@color/car_accent_blue" />
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
