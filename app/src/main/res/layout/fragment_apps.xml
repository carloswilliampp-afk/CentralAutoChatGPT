<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/car_bg_deep"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp">

    <!-- Top Header & Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_drawer_title"
            android:textColor="@color/car_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <View
            android:layout_width="24dp"
            android:layout_height="match_parent" />

        <!-- Search App Filter Input -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_button"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="@color/car_text_secondary" />

            <EditText
                android:id="@+id/et_search_apps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:hint="@string/search_apps_hint"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:textColor="@color/car_text_primary"
                android:textColorHint="@color/car_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <View
            android:layout_width="20dp"
            android:layout_height="match_parent" />

        <!-- Back to Dashboard Button -->
        <LinearLayout
            android:id="@+id/btn_back_dashboard"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_pill_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_map"
                app:tint="@color/car_accent_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/back_to_dashboard"
                android:textColor="@color/car_accent_blue"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Apps RecyclerView Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_apps_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <!-- Empty search result indicator -->
    <TextView
        android:id="@+id/tv_empty_apps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="@string/no_apps_found"
        android:textColor="@color/car_text_dim"
        android:textSize="16sp"
        android:visibility="gone" />

</LinearLayout>
